{
  "name": "cypress-cartes-gouv-fr",
  "version": "1.0.0",
  "description": "Cypress E2E tests for cartes.gouv.fr",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:headed": "cypress run --headed",
    "test:spec": "cypress run --spec",
    "clean:reports": "rm -rf cypress/reports && mkdir -p cypress/reports/json cypress/reports/html",
    "prereport": "mkdir -p cypress/reports/html cypress/reports/mochawesome && rm -rf cypress/reports/html/*",
    "report:merge": "mochawesome-merge cypress/reports/json/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json --reportDir cypress/reports/html --inline",
    "report": "npm run report:merge && npm run report:generate",
    "test:report": "npm run clean:reports && npm test && npm run report",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "monitor": "cypress run --spec cypress/e2e/monitoring.cy.js",
    "crawl": "cypress run --spec cypress/e2e/site-crawler.cy.js"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^6.0.0",
    "axe-core": "^4.11.1",
    "cypress": "^15.11.0",
    "cypress-axe": "^1.7.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
