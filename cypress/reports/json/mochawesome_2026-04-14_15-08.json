          "code": "cy.on('uncaught:exception', () => false);\ncy.visit('/explorer-les-cartes/', {\n  timeout: 30000\n});\ncy.get('.ol-viewport', {\n  timeout: 15000\n}).should('be.visible');\ncy.wait(5000);\ncy.document().then(doc => {\n  const inputs = doc.querySelectorAll('input');\n  inputs.forEach((el, i) => {\n    const rect = el.getBoundingClientRect();\n    const cs = getComputedStyle(el);\n    const vis = rect.width > 0 && rect.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden';\n    cy.task('log', `Input[${i}] id=\"${el.id}\" type=\"${el.type}\" name=\"${el.name}\" placeholder=\"${el.placeholder}\" visible=${vis} class=\"${el.className.substring(0, 80)}\"`);\n  });\n});",
